# ------------------------------------------------------------------------------------
#  Project Overrides (GoFortress)
#
#  Purpose: Project-specific settings for this repository. Values here take precedence
#           over the shared defaults loaded from the lower-numbered env files.
#
#  Maintainer: @mrz1836
# ------------------------------------------------------------------------------------

# ------------------------------------------------------------------------------------
# Go Versions
#
# This module declares `go 1.25` in go.mod, so every toolchain used by CI must be at
# least 1.25. These overrides are kept as an explicit belt-and-suspenders pin even
# though the shared defaults now also target 1.25.x.
# ------------------------------------------------------------------------------------
GO_PRIMARY_VERSION=1.25.x
GO_SECONDARY_VERSION=1.25.x
MAGE_X_GO_VERSION=1.25.x
MAGE_X_GO_SECONDARY_VERSION=1.25.x

# ------------------------------------------------------------------------------------
# Coverage
#
# Coverage is published to Codecov (see codecov.yml for the 70..90 target range).
# ------------------------------------------------------------------------------------
GO_COVERAGE_PROVIDER=codecov
CODECOV_TOKEN_REQUIRED=true
GO_COVERAGE_EXCLUDE_PATHS=test/,vendor/,testdata/,.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,testing/,docs/,internal/instantlytest/
